# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# LLM (OpenAI-compatible — works with OpenAI, OpenRouter, Ollama, Groq, etc.)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=meta-llama/llama-3.1-70b-instruct

# STT
DEEPGRAM_API_KEY=your_deepgram_api_key

# TTS
CARTESIA_API_KEY=sk-your-cartesia-api-key
CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Avatar — Beyond Presence (speech-to-video, synced with Cartesia audio)
BEY_API_KEY=sk-your-beyond-presence-key
BEY_AVATAR_ID=your-beyond-presence-avatar-id

# Database
DB_PATH=/app/healthcare.db

# Business hours (optional overrides)
# BUSINESS_HOUR_START=9
# BUSINESS_HOUR_END=17
# SLOT_DURATION_MINUTES=30
